# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Device inventory repository.
# Use "mysql" for the workbook-backed dashboard and inventory flows.
# Switch to "demo" only when you intentionally want the local JSON fallback.
DEVICE_REPOSITORY="mysql"
DEVICE_DEMO_STORE_PATH="data/demo-devices.json"

# MySQL connection settings for /api/devices and Excel imports.
# Prefer DATABASE_URL in production secret storage.
DATABASE_URL="mysql://repairlink_user:strong_password@localhost:3306/repairlink"

# Or configure individual DB variables instead of DATABASE_URL.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="repairlink_user"
DB_PASSWORD="strong_password"
DB_NAME="repairlink"
DB_CONNECTION_LIMIT="10"

# After creating the devices table from docs/device-database.md and placing
# F-IT-010 Rev.01.xlsx in the repository root, import the workbook with:
# npx tsx scripts/import-devices-from-excel.ts
